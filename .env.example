VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key
# Vercel Marketplace / Next-style fallback.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
# TanStack Start fallback.
CLERK_PUBLISHABLE_KEY=pk_test_your_key

CLERK_SECRET_KEY=sk_test_your_key
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
# Optional TanStack Start server auth. Enable only when the public Clerk key
# and CLERK_SECRET_KEY are from the same Clerk instance.
VITE_ENABLE_CLERK_SSR_AUTH=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

HOST_AGENT_MODEL=gpt-5-mini
CRITIC_AGENT_MODEL=gpt-5-mini
STATS_AGENT_MODEL=gemini-3-flash-preview
AI_ARENA_DEMO_MODE=false
