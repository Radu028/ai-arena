    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "convex-test": "0.0.53",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "nitro": "npm:nitro-nightly@3.0.1-20260529-064703-255b254f",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "^6.0.3",
