{
  "name": "ai-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.9"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "concurrently -n web,convex -c blue,magenta \"pnpm run vite:dev\" \"pnpm run convex:dev\"",
    "vite:dev": "vite dev --port 3000",
    "convex:dev": "convex dev",
    "build": "vite build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_pages vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:agents": "vitest run shared/agent-evals.test.ts",
    "test:agents:live": "RUN_LIVE_AGENT_EVALS=true vitest run shared/agent-live-evals.test.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "@chenglou/pretext": "0.0.7",
    "@clerk/tanstack-react-start": "1.3.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@google/genai": "2.7.0",
    "@mistralai/mistralai": "2.2.5",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/react-start": "1.168.18",
    "@tanstack/router-plugin": "1.168.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "convex": "1.39.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nanoid": "5.1.11",
    "next-themes": "^0.4.6",
    "openai": "6.39.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.8.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.60.0",
    "@rsbuild/core": "^2.0.9",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/eslint-config": "0.4.0",
